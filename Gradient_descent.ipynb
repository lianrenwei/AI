
import numpy as np
import matplotlib.pyplot as plt

def func(x): return np.square(x)  #目標函數

def dfunc(x): return 2 * x   #目標函數的一階導函數

def GD(x_start, df, epochs, lr):    #定義梯度下降法
    xs = np.zeros(epochs+1)    
    x = x_start    
    xs[0] = x    
    for i in range(epochs):         
        dx = df(x)      
        v = - dx * lr        
        x += v        
        xs[i+1] = x    
    return xs


x_start = 5    
epochs = 15 
lr = 0.3   
x = GD(x_start, dfunc, epochs, lr=lr)  #呼叫GD函數 執行梯度下降法
print (x)

color = 'r'     
from numpy import arange       #從NumPy 匯入 arange函數
t = arange(-6.0, 6.0, 0.01)
plt.plot(t, func(t), c='b')
plt.plot(x, func(x), c=color, label='lr={}'.format(lr))    
plt.scatter(x, func(x), c=color, )    
plt.legend()    #顯示圖例 標示學習率

plt.show()   #顯示繪製完成圖表
